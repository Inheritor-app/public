# Gas Wallet Configuration
# Copy this file to .env and replace with your actual gas wallet private key
# Private key should be 64 hex characters (0x prefix optional)
GAS_WALLET_PRIVATE_KEY=your_private_key_here
# Optional, for the beneficiary tools (see README.md, Configuration)
# INHERITOR_ENVIRONMENT=production
# INHERITOR_ETHEREUM_RPCS=Provider One=https://...,Provider Two=https://...
# INHERITOR_ARBITRUM_RPCS=Provider One=https://...,Provider Two=https://...
# INHERITOR_KEY_PROVIDER_URL=https://keyprovider-prod.inheritor.workers.dev
# INHERITOR_ARWEAVE_GATEWAYS=https://arweave.net,https://ar-io.net
